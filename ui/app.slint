import { Button, LineEdit, SpinBox, CheckBox, Slider, ComboBox, StandardListView, TextEdit, ListView, ScrollView } from "std-widgets.slint";

export struct Row {
    name: string,
    split: string,
    total: string,
    pb: string,
    delta: string,
    // -1 ahead of the PB, 1 behind, 0 even or no PB.
    sign: int,
}

// Brushed steel: dark gunmetal behind, lighter panels with a lit top edge.
export global Theme {
    out property <brush> window: @linear-gradient(180deg, #2c3137 0%, #1b1e22 60%, #15171a 100%);
    out property <brush> panel: @linear-gradient(180deg, #3a3f47 0%, #2d3138 45%, #25292e 100%);
    out property <brush> brushed: @linear-gradient(90deg, #474e57 0%, #5b636d 16%, #444a52 34%, #58606a 55%, #40464e 76%, #535a63 100%);
    out property <color> edge-light: #ffffff2e;
    out property <color> edge-dark: #0000008c;
    out property <color> text: #e9edf2;
    out property <color> dim: #a7b1bc;
    out property <color> accent: #7cc4ff;
    out property <color> green: #4ade80;
    out property <color> gold: #f5c542;
    out property <color> red: #f87171;
    out property <string> mono: "Consolas";
}

// A raised metal plate with an optional small caps title.
component MetalPanel inherits Rectangle {
    in property <string> title;
    in property <length> inset: 10px;
    background: Theme.panel;
    border-radius: 8px;
    border-width: 1px;
    border-color: Theme.edge-dark;
    drop-shadow-blur: 8px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: #00000070;
    Rectangle {
        x: 8px;
        y: 1px;
        width: parent.width - 16px;
        height: 1px;
        background: Theme.edge-light;
    }
    VerticalLayout {
        padding: root.inset;
        spacing: 8px;
        if root.title != "": Text {
            text: root.title;
            color: Theme.dim;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1.2px;
        }
        @children
    }
}

// Text that stays readable over any game scene when `outline` is on.
component Label inherits Text {
    in property <bool> outline;
    vertical-alignment: center;
    stroke: root.outline ? #000000d8 : transparent;
    stroke-width: root.outline ? 2px : 0px;
    stroke-style: outside;
}

component Cell inherits Label {
    // Wide enough for "10:00.000" at this font size.
    width: max(76px, self.font-size * 4.5);
    horizontal-alignment: right;
    font-family: Theme.mono;
}

// Stopped, waiting, running or complete, in words as well as colour.
component StatusBadge inherits Rectangle {
    in property <int> state;
    property <color> tint: root.state == 3 ? Theme.gold : root.state == 2 ? Theme.green : root.state == 1 ? Theme.accent : Theme.dim;
    border-radius: self.height / 2;
    background: root.tint.with-alpha(0.16);
    border-width: 1px;
    border-color: root.tint.with-alpha(0.7);
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 3px;
        padding-bottom: 3px;
        Text {
            text: root.state == 3 ? "RUN COMPLETE" : root.state == 2 ? "RUNNING" : root.state == 1 ? "WAITING FOR THE START TRIGGER" : "STOPPED";
            color: root.tint;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 1px;
        }
    }
}

component Splits inherits VerticalLayout {
    in property <[Row]> rows;
    in property <int> active: -1;
    in property <color> fg: Theme.text;
    in property <length> size: 14px;
    in property <length> row-height: 24px;
    in property <bool> outline;
    spacing: 1px;
    HorizontalLayout {
        spacing: 8px;
        padding-left: 10px;
        padding-right: 6px;
        Label { text: "SEGMENT"; horizontal-stretch: 1; color: Theme.dim; font-size: root.size * 0.78; font-weight: 700; outline: root.outline; }
        for h in ["SPLIT", "TOTAL", "PB", "+/-"]: Cell { text: h; width: max(76px, root.size * 4.5); color: Theme.dim; font-size: root.size * 0.78; font-weight: 700; font-family: ""; outline: root.outline; }
    }
    for r[i] in root.rows: Rectangle {
        height: root.row-height;
        border-radius: 4px;
        background: i == root.active ? Theme.accent.with-alpha(0.2) : mod(i, 2) == 0 ? #ffffff09 : transparent;
        Rectangle {
            x: 0;
            width: 3px;
            border-radius: 1.5px;
            background: i == root.active ? Theme.accent : transparent;
        }
        HorizontalLayout {
            spacing: 8px;
            padding-left: 10px;
            padding-right: 6px;
            Label { text: r.name; horizontal-stretch: 1; overflow: elide; color: root.fg; font-size: root.size; font-weight: i == root.active ? 600 : 400; outline: root.outline; }
            Cell { text: r.split; color: root.fg; font-size: root.size; outline: root.outline; }
            Cell { text: r.total; color: root.fg; font-size: root.size; outline: root.outline; }
            Cell { text: r.pb; color: Theme.dim; font-size: root.size; outline: root.outline; }
            Cell { text: r.delta; font-size: root.size; outline: root.outline; color: r.sign < 0 ? Theme.green : r.sign > 0 ? Theme.red : Theme.dim; }
        }
    }
}

export component MainWindow inherits Window {
    title: "AutoSplitter " + root.version;
    icon: @image-url("../packaging/icons/autosplitter.png");
    background: Theme.window;
    preferred-width: 860px;
    preferred-height: 900px;
    in property <string> version;
    in property <string> heading;
    in property <string> timer: "0:00.000";
    // 0 green, 1 gold (run complete).
    in property <int> timer-state;
    // 0 stopped, 1 waiting for the start trigger, 2 running, 3 complete.
    in property <int> run-state;
    in property <[Row]> rows;
    in property <int> active-row: -1;
    in property <bool> running;
    in property <[string]> profiles;
    in-out property <int> profile-index;
    in-out property <int> fps: 5;
    in-out property <int> retries: 3;
    in-out property <string> interval: "1";
    in-out property <int> match-percent: 92;
    in-out property <int> pb-protection: 120;
    in-out property <bool> debug;
    in-out property <bool> livesplit;
    in-out property <string> livesplit-host: "localhost";
    in-out property <string> livesplit-port: "16834";
    in-out property <bool> overlay;
    in-out property <float> overlay-opacity: 80;
    in property <string> split-key: "Mouse3";
    in property <bool> binding;
    in property <string> region;
    in property <string> ocr-text;
    in property <string> ocr-ms;
    in property <[string]> log;

    callback start();
    callback reset();
    callback stop();
    callback set-region();
    callback select-profile(int);
    callback browse();
    callback edit();
    callback reload();
    callback new-profile();
    callback delete-profile();
    callback save-settings();
    callback bind-key();
    callback overlay-changed();
    callback debug-changed();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        // Brushed-steel header: what runs, its state, and the clock.
        Rectangle {
            background: Theme.brushed;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge-dark;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #00000080;
            Rectangle { x: 10px; y: 1px; width: parent.width - 20px; height: 1px; background: #ffffff40; }
            HorizontalLayout {
                padding: 14px;
                spacing: 16px;
                VerticalLayout {
                    alignment: center;
                    spacing: 6px;
                    horizontal-stretch: 1;
                    Text { text: root.heading; font-size: 20px; font-weight: 700; color: Theme.text; overflow: elide; }
                    HorizontalLayout {
                        alignment: LayoutAlignment.start;
                        StatusBadge { state: root.run-state; }
                    }
                }
                Text {
                    text: root.timer;
                    font-size: 52px;
                    font-family: Theme.mono;
                    font-weight: 700;
                    color: root.timer-state == 1 ? Theme.gold : Theme.green;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        MetalPanel {
            title: "SPLITS";
            inset: 8px;
            ScrollView {
                height: 7 * 25px + 26px;
                Splits { rows: root.rows; active: root.active-row; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Button { text: "Start (F9)"; primary: true; enabled: !root.running; clicked => { root.start(); } }
            Button { text: "Reset (F10)"; clicked => { root.reset(); } }
            Button { text: "Stop (F11)"; enabled: root.running; clicked => { root.stop(); } }
            Button { text: "Set Region"; enabled: !root.running; clicked => { root.set-region(); } }
            Text { text: "Region  " + root.region; vertical-alignment: center; horizontal-alignment: right; color: Theme.dim; font-family: Theme.mono; horizontal-stretch: 1; }
        }

        MetalPanel {
            title: "PROFILE";
            HorizontalLayout {
                spacing: 6px;
                ComboBox {
                    horizontal-stretch: 1;
                    model: root.profiles;
                    current-index <=> root.profile-index;
                    selected => { root.select-profile(self.current-index); }
                }
                Button { text: "Browse"; clicked => { root.browse(); } }
                Button { text: "Edit"; clicked => { root.edit(); } }
                Button { text: "Reload"; clicked => { root.reload(); } }
                Button { text: "New"; clicked => { root.new-profile(); } }
                Button { text: "Delete"; clicked => { root.delete-profile(); } }
                Button { text: "Save Settings"; primary: true; clicked => { root.save-settings(); } }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            MetalPanel {
                title: "DETECTION";
                horizontal-stretch: 1;
                GridLayout {
                    spacing: 8px;
                    Row {
                        Text { text: "FPS"; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: 30; value <=> root.fps; width: 104px; }
                        Text { text: "Retries"; vertical-alignment: center; }
                        SpinBox { minimum: 1; maximum: max(1, root.fps - 1); value <=> root.retries; width: 104px; }
                    }
                    Row {
                        Text { text: "Interval (s)"; vertical-alignment: center; }
                        LineEdit { text <=> root.interval; input-type: decimal; width: 104px; }
                        Text { text: "Match %"; vertical-alignment: center; }
                        SpinBox { minimum: 50; maximum: 100; value <=> root.match-percent; width: 104px; }
                    }
                    Row {
                        Text { text: "PB protection (s)"; vertical-alignment: center; }
                        SpinBox { minimum: 0; maximum: 36000; value <=> root.pb-protection; width: 104px; }
                        CheckBox { text: "Debug log"; checked <=> root.debug; toggled => { root.debug-changed(); } colspan: 2; }
                    }
                }
            }
            MetalPanel {
                title: "INTEGRATIONS";
                horizontal-stretch: 1;
                GridLayout {
                    spacing: 8px;
                    Row {
                        CheckBox { text: "LiveSplit"; checked <=> root.livesplit; }
                        LineEdit { text <=> root.livesplit-host; enabled: root.livesplit; min-width: 110px; horizontal-stretch: 1; }
                        LineEdit { text <=> root.livesplit-port; input-type: number; enabled: root.livesplit; width: 76px; }
                    }
                    Row {
                        CheckBox { text: "Overlay"; checked <=> root.overlay; toggled => { root.overlay-changed(); } }
                        Slider { minimum: 0; maximum: 100; value <=> root.overlay-opacity; changed => { root.overlay-changed(); } colspan: 2; }
                    }
                    Row {
                        Text { text: "Split key"; vertical-alignment: center; }
                        Button { text: root.binding ? "Press a key…" : root.split-key; clicked => { root.bind-key(); } colspan: 2; }
                    }
                }
            }
        }

        MetalPanel {
            title: "OCR OUTPUT";
            HorizontalLayout {
                spacing: 6px;
                ocr := LineEdit { text: root.ocr-text; read-only: true; horizontal-stretch: 1; }
                Text { text: root.ocr-ms; color: Theme.dim; vertical-alignment: center; font-family: Theme.mono; }
                Button { text: "Copy"; clicked => { ocr.select-all(); ocr.copy(); } }
            }
        }

        MetalPanel {
            title: "LOG";
            vertical-stretch: 1;
            min-height: 140px;
            inset: 8px;
            ListView {
                for line in root.log: Text { text: line; font-family: Theme.mono; font-size: 13px; color: Theme.text; overflow: elide; }
                changed content-height => { self.content-y = min(0px, self.visible-height - self.content-height); }
            }
        }
    }
}

// Found by its title when the window is created (see main.rs).
export component Overlay inherits Window {
    title: "AutoSplitter Overlay";
    no-frame: true;
    always-on-top: true;
    background: transparent;
    in property <string> heading;
    in property <[Row]> rows;
    in property <int> active-row: -1;
    in property <string> timer: "0:00.000";
    in property <int> timer-state;
    in property <string> pb-total;
    in property <float> bg-opacity: 80;
    // Size, set with the grip in the bottom-right corner; 1 is the standard size.
    in-out property <float> scale: 1;
    callback drag();
    width: 620px * root.scale;
    height: content.preferred-height;

    // The plate fades with the opacity setting; the outlined text above it does not.
    Rectangle {
        opacity: root.bg-opacity / 100;
        background: Theme.panel;
        border-radius: 10px * root.scale;
        border-width: 1px;
        border-color: Theme.edge-dark;
        Rectangle { x: 10px; y: 1px; width: parent.width - 20px; height: 1px; background: Theme.edge-light; }
    }
    move := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.drag();
            }
        }
    }
    content := VerticalLayout {
        padding: 12px * root.scale;
        spacing: 4px * root.scale;
        Label { text: root.heading; color: Theme.text; font-size: 16px * root.scale; font-weight: 700; overflow: elide; outline: true; }
        Splits { rows: root.rows; active: root.active-row; size: 17px * root.scale; row-height: 27px * root.scale; outline: true; }
        Label {
            text: root.timer;
            font-size: 50px * root.scale;
            font-family: Theme.mono;
            font-weight: 700;
            horizontal-alignment: right;
            color: root.timer-state == 1 ? Theme.gold : Theme.green;
            outline: true;
        }
        Label { text: "Personal best  " + root.pb-total; color: Theme.text; font-size: 15px * root.scale; horizontal-alignment: right; outline: true; }
    }
    // Shown while the mouse is over the overlay, out of the way during a run.
    grip := TouchArea {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 22px;
        height: 22px;
        mouse-cursor: nwse-resize;
        moved => {
            if (self.pressed) {
                root.scale = clamp(root.scale + (self.mouse-x - self.pressed-x) / 620px, 0.6, 2.5);
            }
        }
        Text {
            text: "\u{25E2}";
            color: Theme.accent;
            font-size: 16px;
            visible: move.has-hover || grip.has-hover;
            horizontal-alignment: right;
            vertical-alignment: bottom;
        }
    }
}

// A full-screen picture of one monitor to drag the OCR region on.
export component RegionPicker inherits Window {
    title: "AutoSplitter Region";
    no-frame: true;
    always-on-top: true;
    forward-focus: keys;
    in property <image> shot;
    in-out property <length> x0;
    in-out property <length> y0;
    in-out property <length> x1;
    in-out property <length> y1;
    callback done();
    callback cancel();
    callback next-monitor();

    Image { source: root.shot; width: parent.width; height: parent.height; image-fit: fill; }
    Rectangle {
        x: min(root.x0, root.x1);
        y: min(root.y0, root.y1);
        width: abs(root.x1 - root.x0);
        height: abs(root.y1 - root.y0);
        border-width: 2px;
        border-color: touch.pressed ? Theme.red : Theme.green;
        background: #ffffff14;
    }
    Rectangle {
        x: 20px;
        y: 20px;
        width: hint.preferred-width + 24px;
        height: hint.preferred-height + 16px;
        background: #000000c0;
        border-radius: 4px;
        hint := Text {
            text: "Drag around the game text. S or Enter saves, Tab shows the next monitor, Esc cancels.";
            color: white;
            font-size: 16px;
        }
    }
    touch := TouchArea {
        mouse-cursor: crosshair;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.x0 = self.mouse-x;
                root.y0 = self.mouse-y;
                root.x1 = self.mouse-x;
                root.y1 = self.mouse-y;
            }
        }
        moved => {
            root.x1 = self.mouse-x;
            root.y1 = self.mouse-y;
        }
    }
    keys := FocusScope {
        key-pressed(e) => {
            if (e.text == Key.Escape || e.text == "q" || e.text == "Q") {
                root.cancel();
                return accept;
            }
            if (e.text == Key.Return || e.text == "s" || e.text == "S") {
                root.done();
                return accept;
            }
            if (e.text == Key.Tab) {
                root.next-monitor();
                return accept;
            }
            reject
        }
    }
}

component KeywordList inherits MetalPanel {
    in property <[StandardListViewItem]> items;
    in-out property <int> current: -1;
    in-out property <string> entry;
    callback add();
    callback remove();
    callback copy-ocr();
    StandardListView { model: root.items; current-item <=> root.current; min-height: 96px; vertical-stretch: 1; }
    HorizontalLayout {
        spacing: 4px;
        LineEdit { text <=> root.entry; placeholder-text: "Keyword"; horizontal-stretch: 1; accepted => { root.add(); } }
        Button { text: "Add"; clicked => { root.add(); } }
        Button { text: "Remove"; enabled: root.current >= 0; clicked => { root.remove(); } }
        Button { text: "Copy OCR"; clicked => { root.copy-ocr(); } }
    }
}

export component EditorWindow inherits Window {
    title: "AutoSplitter Profile Editor " + root.version + (root.file == "" ? "" : " - " + root.file);
    icon: @image-url("../packaging/icons/autosplitter.png");
    background: Theme.window;
    preferred-width: 940px;
    preferred-height: 900px;
    in property <string> version;
    in property <string> file;
    in-out property <string> game;
    in-out property <string> mission;
    in-out property <int> fps: 5;
    in-out property <string> interval: "1";
    in-out property <int> match-percent: 92;
    in-out property <int> retries: 3;
    in-out property <string> cooldown: "5";
    in-out property <int> pb-protection: 120;
    in-out property <int> language;
    in-out property <string> left;
    in-out property <string> top;
    in-out property <string> right;
    in-out property <string> bottom;
    in property <string> ocr-text;
    in property <string> ocr-ms;
    in property <[StandardListViewItem]> from-items;
    in property <[StandardListViewItem]> to-items;
    in property <[StandardListViewItem]> segment-items;
    in-out property <int> from-current: -1;
    in-out property <int> to-current: -1;
    in-out property <string> from-entry;
    in-out property <string> to-entry;
    in-out property <int> segment-current: -1;
    in-out property <string> segment-name;
    in-out property <string> segment-pte: "0";
    in-out property <string> segment-keywords;

    callback new-file();
    callback open-file();
    callback save();
    callback save-as();
    callback region-edited();
    callback set-region();
    callback language-changed();
    callback add-from();
    callback remove-from();
    callback ocr-to-from();
    callback add-to();
    callback remove-to();
    callback ocr-to-to();
    callback select-segment(int);
    callback apply-segment();
    callback add-segment();
    callback remove-segment();
    callback move-segment(int);
    callback ocr-to-segment();

    VerticalLayout {
        padding: 12px;
        spacing: 10px;

        Rectangle {
            background: Theme.brushed;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.edge-dark;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: #00000080;
            Rectangle { x: 10px; y: 1px; width: parent.width - 20px; height: 1px; background: #ffffff40; }
            HorizontalLayout {
                padding: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: root.game == "" && root.mission == "" ? "New profile" : root.game + " \u{2014} " + root.mission;
                        font-size: 18px;
                        font-weight: 700;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text { text: root.file == "" ? "Not saved yet" : root.file; font-size: 12px; color: Theme.text; overflow: elide; }
                }
                Button { text: "New"; clicked => { root.new-file(); } }
                Button { text: "Open"; clicked => { root.open-file(); } }
                Button { text: "Save"; primary: true; clicked => { root.save(); } }
                Button { text: "Save As"; clicked => { root.save-as(); } }
            }
        }

        MetalPanel {
            title: "PROFILE";
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Game"; vertical-alignment: center; }
                LineEdit { text <=> root.game; horizontal-stretch: 1; }
                Text { text: "Mission"; vertical-alignment: center; }
                LineEdit { text <=> root.mission; horizontal-stretch: 1; }
            }
        }

        MetalPanel {
            title: "CAPTURE AND OCR";
            GridLayout {
                spacing: 8px;
                Row {
                    Text { text: "FPS"; vertical-alignment: center; }
                    SpinBox { minimum: 1; maximum: 30; value <=> root.fps; width: 104px; }
                    Text { text: "Retries"; vertical-alignment: center; }
                    SpinBox { minimum: 1; maximum: max(1, root.fps - 1); value <=> root.retries; width: 104px; }
                    Text { text: "Match %"; vertical-alignment: center; }
                    SpinBox { minimum: 50; maximum: 100; value <=> root.match-percent; width: 104px; }
                }
                Row {
                    Text { text: "Interval (s)"; vertical-alignment: center; }
                    LineEdit { text <=> root.interval; input-type: decimal; width: 104px; }
                    Text { text: "Cooldown (s)"; vertical-alignment: center; }
                    LineEdit { text <=> root.cooldown; input-type: decimal; width: 104px; }
                    Text { text: "PB protection (s)"; vertical-alignment: center; }
                    SpinBox { minimum: 0; maximum: 36000; value <=> root.pb-protection; width: 104px; }
                }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Language"; vertical-alignment: center; }
                ComboBox {
                    model: ["English (en)", "Simplified Chinese (zh-CN)"];
                    current-index <=> root.language;
                    selected => { root.language-changed(); }
                    width: 230px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: "Region"; vertical-alignment: center; }
                LineEdit { text <=> root.left; placeholder-text: "Left"; input-type: number; width: 72px; edited => { root.region-edited(); } }
                LineEdit { text <=> root.top; placeholder-text: "Top"; input-type: number; width: 72px; edited => { root.region-edited(); } }
                LineEdit { text <=> root.right; placeholder-text: "Right"; input-type: number; width: 72px; edited => { root.region-edited(); } }
                LineEdit { text <=> root.bottom; placeholder-text: "Bottom"; input-type: number; width: 72px; edited => { root.region-edited(); } }
                Button { text: "Set Region"; clicked => { root.set-region(); } }
            }
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Live OCR"; color: Theme.dim; vertical-alignment: center; }
                ocr := LineEdit { text: root.ocr-text; read-only: true; horizontal-stretch: 1; }
                Text { text: root.ocr-ms; color: Theme.dim; vertical-alignment: center; font-family: Theme.mono; }
                Button { text: "Copy"; clicked => { ocr.select-all(); ocr.copy(); } }
            }
        }

        HorizontalLayout {
            spacing: 10px;
            vertical-stretch: 1;
            KeywordList {
                title: "START TRIGGER: FROM (EMPTY STARTS ON TO ALONE)";
                horizontal-stretch: 1;
                items: root.from-items;
                current <=> root.from-current;
                entry <=> root.from-entry;
                add => { root.add-from(); }
                remove => { root.remove-from(); }
                copy-ocr => { root.ocr-to-from(); }
            }
            KeywordList {
                title: "START TRIGGER: TO";
                horizontal-stretch: 1;
                items: root.to-items;
                current <=> root.to-current;
                entry <=> root.to-entry;
                add => { root.add-to(); }
                remove => { root.remove-to(); }
                copy-ocr => { root.ocr-to-to(); }
            }
        }

        MetalPanel {
            title: "SEGMENTS (THE LAST ONE ENDS THE RUN)";
            vertical-stretch: 2;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    spacing: 4px;
                    horizontal-stretch: 1;
                    StandardListView {
                        model: root.segment-items;
                        current-item <=> root.segment-current;
                        current-item-changed(i) => { root.select-segment(i); }
                        vertical-stretch: 1;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Button { text: "Add"; clicked => { root.add-segment(); } }
                        Button { text: "Remove"; enabled: root.segment-current >= 0; clicked => { root.remove-segment(); } }
                        Button { text: "Up"; enabled: root.segment-current > 0; clicked => { root.move-segment(-1); } }
                        Button { text: "Down"; enabled: root.segment-current >= 0 && root.segment-current < root.segment-items.length - 1; clicked => { root.move-segment(1); } }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    horizontal-stretch: 1;
                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "Name"; vertical-alignment: center; }
                        LineEdit { text <=> root.segment-name; horizontal-stretch: 1; }
                        Text { text: "Blocked for (s)"; vertical-alignment: center; }
                        LineEdit { text <=> root.segment-pte; width: 64px; input-type: number; }
                    }
                    Text { text: "Keywords, one per line. Any one of them matches."; color: Theme.dim; }
                    TextEdit { text <=> root.segment-keywords; vertical-stretch: 1; }
                    HorizontalLayout {
                        spacing: 4px;
                        Button { text: "Copy OCR"; clicked => { root.ocr-to-segment(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Apply"; primary: true; clicked => { root.apply-segment(); } }
                    }
                }
            }
        }
    }
}
